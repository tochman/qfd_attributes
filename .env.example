# Pick one block.

# Claude (paid, key from https://console.anthropic.com). Models starting with claude- use
# Anthropic's SDK; LLM_BASE_URL is ignored. Cheaper: claude-sonnet-5-5, claude-haiku-4-5.
# ANTHROPIC_API_KEY=your_anthropic_key
# LLM_MODEL=claude-opus-5-5

# Any OpenAI-compatible endpoint works below.

# Google Gemini (free tier, key from https://aistudio.google.com/apikey)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_key
LLM_MODEL=gemini-3.8-flash

# Groq (free tier, key from https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your_groq_key
# LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter free models (key from https://openrouter.ai/keys)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_key
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama, fully local (https://ollama.com, then: ollama pull qwen2.5:7b)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
